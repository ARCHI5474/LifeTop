rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/state {
      function owner() {
        return collection in ['lifetop', 'canvas'] && request.auth != null && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }
      function validDocument() {
        let d = request.resource.data;
        return d.keys().hasAll(['schema', 'revision', 'payload', 'updatedAt'])
          && d.keys().hasOnly(['schema', 'revision', 'payload', 'updatedAt'])
          && d.schema == 1 && d.revision is int
          && d.payload is string && d.payload.size() <= 921600
          && d.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && validDocument() && request.resource.data.revision == 1;
      allow update: if owner() && validDocument()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /messageRooms/{roomId} {
      function member() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && !resource.data.deleted
          && request.auth.uid in resource.data.members
          && resource.data.lastUsedAtMs >= request.time.toMillis() - 7776000000;
      }
      allow get: if member();
      allow list, write: if false;
      match /messages/{messageId} {
        function roomMember() {
          let room = get(/databases/$(database)/documents/messageRooms/$(roomId)).data;
          return request.auth != null
            && request.auth.token.firebase.sign_in_provider == 'anonymous'
            && !room.deleted && request.auth.uid in room.members
            && room.lastUsedAtMs >= request.time.toMillis() - 7776000000;
        }
        allow get: if roomMember() && resource.data.expiresAt > request.time;
        allow list: if roomMember() && request.query.limit != null && request.query.limit <= 100
          && resource.data.expiresAt > request.time;
        allow write: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
